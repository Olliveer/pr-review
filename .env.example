# VCS: bitbucket (default) or github
VCS_PROVIDER=bitbucket

# Bitbucket (required when VCS_PROVIDER=bitbucket)
# Prefer API token + Atlassian account email as username.
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_WEBHOOK_SECRET=

# GitHub.com (required when VCS_PROVIDER=github)
GITHUB_TOKEN=

# Use a chat/coding model that can return JSON. Content-safety / classifier
# models (e.g. *content-safety*) will fail with AI_NoObjectGeneratedError.
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-sonnet-4
# Examples: anthropic/claude-sonnet-4 | openai/gpt-4o-mini | google/gemini-2.5-flash
# Ollama example:
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434
# (factory appends /api if missing)

OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

PORT=3000
MAX_DIFF_CHARS=80000

# Review policy
# REVIEW_SEVERITY_MIN: info | warning | critical (default: warning)
REVIEW_SEVERITY_MIN=warning
# REVIEW_FOCUS: all | bugs | security | performance (default: all)
REVIEW_FOCUS=all
# REVIEW_INLINE: true | false (default: true)
REVIEW_INLINE=true
# REVIEW_APPROVE: true | false (default: true)
REVIEW_APPROVE=true
